#!/bin/sh
# Show OpenWISP management on the status LED of every Cambium family: blue
# while the controller answers this device's checksum request, green
# otherwise. Families name the LEDs differently (blue:status / green:status
# on Sage, Thor, Cheetah and Miami; jaguar:status:blue / jaguar:status:green on
# Jaguar). Without blue, a green/amber pair shows green while managed and
# amber otherwise (E400). Boards without either complete pair keep their LEDs
# as they are. The managed state file is kept up to date either way: Sage's upgrade
# commit waits for it on OpenWISP-managed access points.
set -u

leds=${CAMBIUM_OPENWISP_LEDS:-/sys/class/leds}
state=${CAMBIUM_OPENWISP_LED_STATE:-/tmp/cambium-openwisp-managed}
interval=${CAMBIUM_OPENWISP_LED_INTERVAL:-60}
once=${CAMBIUM_OPENWISP_LED_ONCE:-0}

# The first existing LED named $1 under $leds.
find_led() {
	local name
	for name in $1; do
		[ -d "$leds/$name" ] && { echo "$leds/$name"; return 0; }
	done
	return 1
}
blue_led=$(find_led 'blue:status jaguar:status:blue') || blue_led=
green_led=$(find_led 'green:status jaguar:status:green') || green_led=
amber_led=$(find_led 'amber:status') || amber_led=
managed_led= unmanaged_led=
if [ -n "$blue_led" ] && [ -n "$green_led" ]; then
	managed_led=$blue_led
	unmanaged_led=$green_led
elif [ -n "$green_led" ] && [ -n "$amber_led" ]; then
	managed_led=$green_led
	unmanaged_led=$amber_led
fi

set_managed() {
	[ -n "$managed_led" ] && [ -n "$unmanaged_led" ] || return 0
	printf '%s\n' none >"$managed_led/trigger"
	printf '%s\n' none >"$unmanaged_led/trigger"
	if [ "$1" = 1 ]; then
		printf '%s\n' 0 >"$unmanaged_led/brightness"
		printf '%s\n' 1 >"$managed_led/brightness"
	else
		printf '%s\n' 0 >"$managed_led/brightness"
		printf '%s\n' 1 >"$unmanaged_led/brightness"
	fi
}

# Use the same colour selection when the init service stops.
if [ "${1:-}" = --unmanaged ]; then
	set_managed 0
	rm -f "$state"
	exit 0
fi

managed() {
	local url uuid key management_interface management_ip work config headers status
	command -v openwisp-get-address >/dev/null 2>&1 || return 1
	command -v curl >/dev/null 2>&1 || return 1
	url=$(uci -q get openwisp.http.url) || return 1
	uuid=$(uci -q get openwisp.http.uuid) || return 1
	key=$(uci -q get openwisp.http.key) || return 1
	management_interface=$(uci -q get openwisp.http.management_interface) || return 1
	management_ip=$(openwisp-get-address "$management_interface") || return 1

	case "$url" in
		https://*) ;;
		*) return 1 ;;
	esac
	printf '%s' "$url" | grep -Eq '^https://[0-9A-Za-z._:-]+(/[^"[:space:]]*)?$' || return 1
	printf '%s' "$uuid" | grep -Eq '^[0-9A-Fa-f-]{32,36}$' || return 1
	printf '%s' "$key" | grep -Eq '^[0-9A-Za-z_-]{16,128}$' || return 1
	printf '%s' "$management_ip" | grep -Eq '^[0-9A-Fa-f:.]+$' || return 1

	umask 077
	work=/tmp/cambium-openwisp-led.$$
	config=$work.curl
	headers=$work.headers
	printf 'url = "%s/controller/checksum/%s/?key=%s&management_ip=%s"\n' \
		"$url" "$uuid" "$key" "$management_ip" >"$config"
	status=$(curl --silent --show-error --connect-timeout 5 --max-time 15 \
		--dump-header "$headers" --output /dev/null --write-out '%{http_code}' \
		--config "$config" 2>/dev/null) || {
		rm -f "$config" "$headers"
		return 1
	}
	if [ "$status" = 200 ] && grep -qi '^X-Openwisp-Controller:' "$headers"; then
		rm -f "$config" "$headers"
		return 0
	fi
	rm -f "$config" "$headers"
	return 1
}

case "$interval" in
	''|*[!0-9]*) interval=60 ;;
esac
[ "$interval" -ge 15 ] || interval=15

trap 'set_managed 0; rm -f "$state"; exit 0' INT TERM
while :; do
	if managed; then
		touch "$state"
		set_managed 1
	else
		rm -f "$state"
		set_managed 0
	fi
	[ "$once" = 1 ] && exit 0
	sleep "$interval" &
	wait $!
done
