#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/cambium-openwisp-led
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

# Back to plain green (not managed) when the service stops.
stop_service() {
	local led
	for led in /sys/class/leds/blue:status /sys/class/leds/jaguar:status:blue; do
		[ -d "$led" ] || continue
		printf '%s\n' none >"$led/trigger"
		printf '%s\n' 0 >"$led/brightness"
	done
	for led in /sys/class/leds/green:status /sys/class/leds/jaguar:status:green; do
		[ -d "$led" ] || continue
		printf '%s\n' none >"$led/trigger"
		printf '%s\n' 1 >"$led/brightness"
	done
	rm -f /tmp/cambium-openwisp-managed
}

service_triggers() {
	procd_add_reload_trigger openwisp
}
