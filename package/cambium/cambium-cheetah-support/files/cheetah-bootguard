#!/bin/sh
set -e

. /lib/functions/system.sh
# One family image carries every model; boot this board's own configuration.
# Only the XV2-21X radio configuration is hardware-validated, so only it
# requires both radios to be up before OpenWrt is kept.
case "$(board_name)" in
	cambiumnetworks,xv2-21x) config='config@mp03.3-ocelot'; require_radios=1 ;;
	cambiumnetworks,xv2-22h) config='config@mp03.3-cheetah'; require_radios=0 ;;
	cambiumnetworks,xv2-23t) config='config@mp03.3-lynx'; require_radios=0 ;;
	*) exit 0 ;;
esac
grep -q 'ubi.mtd=rootfs' /proc/cmdline || exit 0

bootcmd="setenv bootcmd bootipq; setenv changing_bootcmd; saveenv; nand device 0; setenv mtdids nand0=nand0; setenv mtdparts \"mtdparts=nand0:0x6000000@0x80000(fs)\"; ubi part fs && ubi read 0x60000000 kernel && bootm 0x60000000#$config; bootipq"

healthy() {
	[ "$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)" = 1 ] || return 1
	[ -e /dev/ubiblock0_1 ] || return 1
	# Board data is imported from the retained OEM slot at boot. Without it the
	# radios cannot start; keep the wired AP rather than falling back to OEM.
	if [ "$require_radios" = 1 ] &&
	   [ -s /lib/firmware/ath11k/IPQ5018/hw1.0/board.bin ] &&
	   [ -s /lib/firmware/ath11k/QCN6122/hw1.0/board.bin ]; then
		[ -d /sys/class/ieee80211/phy0 ] && [ -d /sys/class/ieee80211/phy1 ] || return 1
	fi
	# XV2-21X manages on the VLAN-1 bridge interface; other models use br-lan.
	lan=br-lan.1
	[ -d /sys/class/net/$lan ] || lan=br-lan
	ip -4 address show dev "$lan" | grep -q 'inet ' || return 1
	ip -4 route show default dev "$lan" | grep -q '^default ' || return 1
}

# The previous U-Boot command already selected OEM before trying this image.
# Only a fully started system is allowed to select OpenWrt for the next boot.
attempt=0
while [ "$attempt" -lt 60 ]; do
	if healthy; then
		current=$(fw_printenv -n bootcmd)
		[ "$current" = bootipq ] || {
			logger -t cheetah-bootguard "bootcmd changed independently; leaving it alone"
			exit 1
		}
		[ "$(fw_printenv -n image)" = 1 ] || exit 1
		fw_setenv changing_bootcmd 1
		fw_setenv bootcmd "$bootcmd"
		[ "$(fw_printenv -n bootcmd)" = "$bootcmd" ] || exit 1
		logger -t cheetah-bootguard "healthy; guarded OpenWrt boot rearmed"
		exit 0
	fi
	attempt=$((attempt + 1))
	sleep 5
done

logger -t cheetah-bootguard "startup checks failed; rebooting to OEM"
reboot
