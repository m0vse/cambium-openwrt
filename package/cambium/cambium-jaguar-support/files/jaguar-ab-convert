#!/bin/sh
# One-time Jaguar conversion: replace the OEM firmware in the inactive bank
# with a copy of the running OpenWrt bank, so both banks run OpenWrt and
# normal sysupgrade can write whichever is inactive.
#
# Usage: jaguar-ab-convert --oem-sha256 HASH [--allow-untested] --yes
#        jaguar-ab-convert --resume --yes
#
#   --oem-sha256 HASH  SHA-256 of your verified off-device copy of the OEM
#                      bank (e.g. dd if=/dev/mtdNro). The live bank must match
#                      it exactly, proving the backup before it is erased.
#   --allow-untested   permit a model whose A/B layout is not yet validated
#   --resume           finish a conversion that was interrupted after the
#                      OEM bank was erased (the backup was already proven)
#   --yes              required; erasing the OEM bank cannot be undone here
#
# Before anything is erased: the board, SKU and bank layout must match, the
# running bank must hold a valid device-data vault (filled from the OEM slot
# at first boot), and the boot environment must already boot the running
# bank first. The OEM image value is kept as jaguar_ab_oem_image.

. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
. "${CAMBIUM_JAGUAR_LIB:-/lib/functions/cambium-jaguar.sh}"
. "${CAMBIUM_JAGUAR_UPGRADE_LIB:-/lib/upgrade/cambium-jaguar.sh}"

die() {
	echo "jaguar-ab-convert: $*" >&2
	logger -t jaguar-ab-convert "refused: $*" 2>/dev/null
	exit 1
}

oem_sha= allow_untested= resume= yes=
while [ $# -gt 0 ]; do
	case "$1" in
	--oem-sha256) oem_sha=$2; shift ;;
	--allow-untested) allow_untested=1 ;;
	--resume) resume=1 ;;
	--yes) yes=1 ;;
	*) die "unknown argument $1" ;;
	esac
	shift
done
[ -n "$yes" ] || die 'pass --yes to confirm erasing the OEM bank'

jaguar_family || die 'not a Cambium Jaguar family image'
jaguar_identity || die 'identity or layout check failed'
jaguar_ab_converted && die 'already converted; use sysupgrade'
[ "$JAGUAR_QUALIFIED" = 1 ] || [ -n "$allow_untested" ] ||
	die "$JAGUAR_MODEL has no validated A/B conversion yet (--allow-untested overrides)"
jaguar_mtd_writable "$JAGUAR_TARGET_MTD" ||
	die "bank $JAGUAR_TARGET_PART is read-only: install the A/B persistent image first"
${JAGUAR_BOARD_DATA:-/usr/sbin/cambium-board-data} --check-vault ||
	die 'the running bank has no valid device-data vault; check cambium-board-data first'

state=$(jaguar_getenv jaguar_ab_state)
dev=${JAGUAR_DEV:-/dev}
if [ -n "$resume" ]; then
	case "$state" in
	converting|convert-failed) ;;
	*) die 'nothing to resume' ;;
	esac
else
	case "$oem_sha" in
	[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
	*) die 'give the SHA-256 of your off-device OEM backup with --oem-sha256' ;;
	esac
	jaguar_ubi_for_mtd "$JAGUAR_TARGET_MTD" >/dev/null &&
		die "bank $JAGUAR_TARGET_PART is attached; reboot first"
	echo "Hashing the OEM bank $JAGUAR_TARGET_PART (mtd$JAGUAR_TARGET_MTD)..."
	live=$(sha256sum < "$dev/mtd$JAGUAR_TARGET_MTD" | cut -d' ' -f1)
	[ "$live" = "$oem_sha" ] ||
		die "live OEM bank hash $live does not match your backup $oem_sha"
fi

# Boot environment: the running bank must come first before the OEM bank is
# touched, so a power cut never leaves OEM bootipq pointing at a half-written
# bank. changing_bootcmd is its own write, before bootcmd.
if [ -z "$resume" ]; then
	oem_image=$(jaguar_getenv image)
	batch=/tmp/jaguar-convert.$$
	printf 'jaguar_ab_oem_image %s\njaguar_ab_state converting\n' "${oem_image:-unset}" > "$batch"
	jaguar_setenv_batch "$batch" || die 'cannot record the conversion'
	rm -f "$batch"
fi
[ "$(jaguar_getenv changing_bootcmd)" = 1 ] || jaguar_setenv changing_bootcmd 1 ||
	die 'cannot save changing_bootcmd'
jaguar_write_boot_vars || die 'cannot write the boot commands'
jaguar_setenv bootcmd "run jaguar_stable$JAGUAR_ACTIVE" || die 'cannot write bootcmd'
jaguar_setenv image "$JAGUAR_ACTIVE" || die 'cannot write image'

fail() {
	batch=/tmp/jaguar-convert.$$
	printf 'jaguar_ab_state convert-failed\njaguar_ab_last_failure %s\n' "${JAGUAR_STEP_ERROR:-$1}" > "$batch"
	jaguar_setenv_batch "$batch" >/dev/null 2>&1
	rm -f "$batch"
	die "$1 (slot $JAGUAR_ACTIVE still boots first; rerun with --resume)"
}

echo "Writing slot $JAGUAR_TARGET ($JAGUAR_TARGET_PART) from running slot $JAGUAR_ACTIVE..."
src_kernel=$dev/$(jaguar_ubi_volume "$JAGUAR_ACTIVE_UBI" kernel)
src_root=$dev/$(jaguar_ubi_volume "$JAGUAR_ACTIVE_UBI" rootfs)
kernel_size=$(cat "${JAGUAR_UBI_SYS:-/sys/class/ubi}/${src_kernel##*/}/data_bytes")
root_size=$(cat "${JAGUAR_UBI_SYS:-/sys/class/ubi}/${src_root##*/}/data_bytes")
jaguar_prepare_bank "$kernel_size" "$root_size" || fail "cannot format slot $JAGUAR_TARGET"
# A UBI volume's stat size is 0, so give ubiupdatevol each length.
jaguar_step "ubiupdatevol kernel" ubiupdatevol -s "$kernel_size" "$dev/${JAGUAR_TARGET_UBI}_0" "$src_kernel" &&
	jaguar_step "ubiupdatevol rootfs" ubiupdatevol -s "$root_size" "$dev/${JAGUAR_TARGET_UBI}_1" "$src_root" ||
	fail "cannot write slot $JAGUAR_TARGET"
jaguar_verify_volume "$dev/${JAGUAR_TARGET_UBI}_0" "$src_kernel" "$kernel_size" &&
	jaguar_verify_volume "$dev/${JAGUAR_TARGET_UBI}_1" "$src_root" "$root_size" ||
	fail "slot $JAGUAR_TARGET readback mismatch"
jaguar_copy_vault || fail 'cannot copy the device-data vault'
sync

# Converted: jaguar_ab_version is written last.
batch=/tmp/jaguar-convert.$$
printf 'jaguar_ab_confirmed %s\njaguar_ab_state confirmed\njaguar_ab_version 1\n' "$JAGUAR_ACTIVE" > "$batch"
echo jaguar_ab_target >> "$batch"
jaguar_setenv_batch "$batch" || fail 'cannot record the finished conversion'
rm -f "$batch"
logger -t jaguar-ab-convert "slot $JAGUAR_TARGET converted; slot $JAGUAR_ACTIVE is the default" 2>/dev/null
echo "Converted: both banks run OpenWrt. Slot $JAGUAR_ACTIVE is the default, slot $JAGUAR_TARGET the fallback."
