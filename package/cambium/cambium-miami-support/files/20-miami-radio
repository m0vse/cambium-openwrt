#!/bin/sh
# Miami: when a radio registers, generate its wireless config and apply the
# deployment country to radios that have none. A radio that wifi config
# creates disabled (OpenWrt's default) stays disabled, as do the default
# SSIDs, until configured (OpenWISP template, LuCI or by hand); only a radio
# without a disabled option is enabled.
[ "$ACTION" = add ] || exit 0
country=$(uci -q get system.@system[0].miami_country)
[ -n "$country" ] || country=GB
iw reg set "$country" 2>/dev/null
wifi config >/dev/null 2>&1
for r in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	c=$(uci -q get wireless.$r.country)
	{ [ -n "$c" ] && [ "$c" != 00 ]; } || uci -q set wireless.$r.country="$country"
	[ -n "$(uci -q get wireless.$r.disabled)" ] || uci -q set wireless.$r.disabled=0
done
uci -q commit wireless
