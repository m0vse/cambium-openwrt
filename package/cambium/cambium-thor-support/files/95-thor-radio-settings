#!/bin/sh

case "$ACTION" in
	post-reload|config-restored)
		# Managed file archives may recreate this directory with permissive
		# defaults. Dropbear deliberately ignores authorized_keys unless the
		# directory is writable only by root.
		chmod 0700 /etc/dropbear 2>/dev/null || true
		chmod 0600 /etc/dropbear/authorized_keys 2>/dev/null || true
		/usr/sbin/thor-radio-settings sync
		;;
esac
