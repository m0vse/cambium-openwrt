#!/bin/sh /etc/rc.common

. /lib/functions/system.sh

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -f /lib/functions/cambium-sage.sh ] || return 0
	. /lib/functions/cambium-sage.sh
	cambium_sage_board && [ "$SAGE_QUALIFIED" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/sage-sysupgrade-mark-good
	procd_close_instance
}
