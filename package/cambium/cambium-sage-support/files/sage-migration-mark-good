#!/bin/sh
set -eu

IPKG_INSTROOT=${IPKG_INSTROOT:-}
export IPKG_INSTROOT
. /lib/functions/system.sh

die() {
	echo "sage-migration-mark-good: $*" >&2
	exit 1
}

[ "$(id -u)" = 0 ] || die 'root is required'
[ "$(board_name)" = 'cambium,e410' ] || die 'this command is restricted to the Cambium E410'
[ "${1:-}" = '--confirm' ] || die 'use --confirm only after checking networking, radios and (if used) OpenWISP'

trial=$(fw_printenv -n owrt_trial_slot 2>/dev/null) || die 'no migration trial is recorded'
fallback=$(fw_printenv -n owrt_fallback_slot 2>/dev/null) || die 'no OEM fallback slot is recorded'
case "$trial:$fallback" in 0:1|1:0) ;; *) die 'invalid trial/fallback slot metadata' ;; esac

current=$(sed -n 's/.*root=ubi0:rootfs\([01]\).*/\1/p' /proc/cmdline)
[ "$current" = "$trial" ] || die "running rootfs$current does not match trial slot $trial"
root_hash=$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)
case "$root_hash" in ''|'!'|'*') die 'root password is blank or locked' ;; esac

# Managed deployments must be reachable by their controller before the slot is
# committed; standalone APs (no controller URL configured) skip this check.
if [ -n "$(uci -q get openwisp.http.url)" ]; then
	[ -f /tmp/cambium-openwisp-managed ] || die 'authenticated OpenWISP connectivity is not current'
	/etc/init.d/openwisp-config running >/dev/null 2>&1 || die 'openwisp-config is not running'
	/etc/init.d/openwisp-monitoring running >/dev/null 2>&1 || die 'openwisp-monitoring is not running'
fi
[ -d /sys/class/ieee80211/phy0 ] && [ -d /sys/class/ieee80211/phy1 ] || die 'both Wi-Fi radios are not present'
ubus call network.interface.lan status | jsonfilter -e '@.up' | grep -qx true || die 'LAN is not up'

mkdir -p /etc/openwisp
umask 077
fw_printenv > /etc/openwisp/sage-env-before-mark-good

bootcmd="setenv image $trial; setenv bootargs \"mtdparts=spi0.1:128M(fs) ubi.mtd=fs root=ubi0:rootfs\${image} rootfstype=ubifs rootwait\"; nand device 1 && setenv mtdids nand1=nand1 && setenv mtdparts \"mtdparts=nand1:0x8000000@0x0(fs)\" && ubi part fs && ubi read 0x84000000 linux\${image} && bootm 0x84000000#config@ap.dk01.1-c2; setenv image $fallback; bootipq"
fw_setenv bootcmd "$bootcmd"
fw_setenv image "$trial"
fw_setenv bootcount 0
fw_setenv owrt_migration_state committed
sync

[ "$(fw_printenv -n bootcmd)" = "$bootcmd" ] || die 'bootcmd readback failed'
[ "$(fw_printenv -n image)" = "$trial" ] || die 'image readback failed'
echo "OpenWrt slot $trial is committed; OEM slot $fallback remains the boot fallback."
