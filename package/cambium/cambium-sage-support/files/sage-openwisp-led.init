#!/bin/sh /etc/rc.common

. /lib/functions/system.sh

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(board_name 2>/dev/null)" = 'cambium,e410' ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/sage-openwisp-led
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	local blue=/sys/class/leds/blue:status
	local green=/sys/class/leds/green:status
	[ -d "$blue" ] && [ -d "$green" ] || return 0
	printf '%s\n' none >"$blue/trigger"
	printf '%s\n' 0 >"$blue/brightness"
	printf '%s\n' none >"$green/trigger"
	printf '%s\n' 1 >"$green/brightness"
	rm -f /tmp/sage-openwisp-managed
}

service_triggers() {
	procd_add_reload_trigger openwisp
}
