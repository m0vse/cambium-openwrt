#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get cambium_rrm.agent.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/cambium-rrm-agent --loop
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cambium_rrm
}
