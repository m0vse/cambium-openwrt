config agent 'agent'
	option enabled '1'
	# Seconds between measurements.
	option interval '300'
	# 1: send each measurement to OpenWISP, when the AP is registered there.
	option upload '1'
	# Local times (HH:MM, space-separated) at which the serving radios scan
	# for neighbouring networks, e.g. '02:00 03:00 04:00'. Each scan takes
	# a radio off its channel for a few seconds; a radio with clients waits,
	# except at the last time. Empty: no such scans. Not used on an AP with
	# a dedicated scanning radio, which scans at every measurement.
	option scan_times ''
