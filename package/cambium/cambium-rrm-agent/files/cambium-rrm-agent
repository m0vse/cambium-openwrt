#!/bin/sh
# Cambium RRM measurement agent: what the radio resource planner needs from
# each access point, on every family.
#
#   cambium-rrm-agent --once    measure once and write the result
#   cambium-rrm-agent --loop    measure every cambium_rrm.agent.interval seconds
#
# Each measurement records every radio's driver, operating channel, width,
# survey (channel active, busy, receive and transmit time, noise) and client
# count, and the neighbouring networks: from a dedicated scanning radio at
# every measurement where the family has one (its scan0 interface exists
# only while it scans), otherwise from the serving radios' own scans at
# cambium_rrm.agent.scan_times. The result, one file for OpenWISP to
# collect, is $RRM_OUT/latest.json; an AP registered with OpenWISP sends it
# there after each measurement (cambium_rrm.agent.upload, on by default).
#
# Test hooks: CAMBIUM_RRM_LIB, CAMBIUM_SYSTEM_FUNCTIONS and those of the
# library (/lib/functions/cambium-rrm.sh).

. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
. "${CAMBIUM_RRM_LIB:-/lib/functions/cambium-rrm.sh}"

# One measurement at a time: a run by hand waits for the service's current
# one (they would share the scanning interface and the output files). A lock
# left by a run that died is stale after ten minutes.
lock=$RRM_OUT/lock
run() {
	local waited=0
	mkdir -p "$RRM_OUT"
	until mkdir "$lock" 2>/dev/null; do
		if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
			rm -rf "$lock"
		elif [ "$waited" -ge 60 ]; then
			echo "cambium-rrm-agent: another measurement is still running" >&2
			return 1
		else
			sleep 2
			waited=$((waited + 2))
		fi
	done
	# The lock is this run's now: release it however the run ends.
	trap 'rmdir "$lock" 2>/dev/null' EXIT
	trap 'exit 0' INT TERM
	rrm_measure
	rrm_upload || :
	rmdir "$lock"
	trap - EXIT
}

case "${1:-}" in
--once)
	run
	;;
--loop)
	while :; do
		run
		interval=$(uci -q get cambium_rrm.agent.interval)
		case "$interval" in ''|*[!0-9]*) interval=300 ;; esac
		[ "$interval" -ge 60 ] || interval=60
		sleep "$interval"
	done
	;;
*)
	echo "usage: $0 --once | --loop" >&2
	exit 2
	;;
esac
