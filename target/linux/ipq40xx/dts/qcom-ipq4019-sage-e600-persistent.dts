/dts-v1/;

#include "qcom-ipq4019-sage-dk07-persistent.dtsi"

/ {
	model = "Cambium Networks E600";
	compatible = "cambiumnetworks,e600", "qcom,ipq4019";
	cambium-platform { compatible = "cambium-platform"; board-sku = <11>; };
};

&swport1 { status = "disabled"; };
&swport2 { status = "disabled"; };
&swport3 { status = "disabled"; };
&swport4 { status = "okay"; label = "lan1"; };
&swport5 { status = "okay"; label = "lan2"; };
