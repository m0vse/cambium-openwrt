From: Phil Taylor <phil@m0vse.uk>
Subject: [PATCH] net: mdio: ipq4019: enable the Cambium X7-35X PHY reference clock

On the Cambium X7-35X (IPQ5332) the QCA8081 PHY on MDIO 0x1c answers ID
reads but ignores every write until its 50 MHz reference clock runs. The
reference comes from the UNIPHY0 PCS (+0x610 bit 0, PCS_CLKOUT_50M_25M_EN),
which needs the UNIPHY0 AHB and SYS clocks; U-Boot leaves the bit clear.

On this machine only, enable those clocks and map the UNIPHY +0x610
register (shared with the PCS register window, so not requested
exclusively) as the ethernet LDO resource, so the bus reset sets bit 0
before the PHY is reset.

Signed-off-by: Phil Taylor <phil@m0vse.uk>
---
--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -328,6 +328,8 @@
 	struct ipq4019_mdio_data *priv;
 	struct mii_bus *bus;
 	struct resource *res;
+	struct clk *uniphy_clk;
+	bool miami = of_machine_is_compatible("cambiumnetworks,x7-35x");
 	int ret;
 
 	bus = devm_mdiobus_alloc_size(&pdev->dev, sizeof(*priv));
@@ -343,6 +345,18 @@
 	priv->mdio_clk = devm_clk_get_optional(&pdev->dev, "gcc_mdio_ahb_clk");
 	if (IS_ERR(priv->mdio_clk))
 		return PTR_ERR(priv->mdio_clk);
+
+	/* Miami needs the UNIPHY reference-clock output before PHY reset.
+	 * Keep its register interface and reference source enabled first.
+	 */
+	if (miami) {
+		uniphy_clk = devm_clk_get_optional_enabled(&pdev->dev, "uniphy0_ahb");
+		if (IS_ERR(uniphy_clk))
+			return PTR_ERR(uniphy_clk);
+		uniphy_clk = devm_clk_get_optional_enabled(&pdev->dev, "uniphy0_sys");
+		if (IS_ERR(uniphy_clk))
+			return PTR_ERR(uniphy_clk);
+	}
 
 	ipq4019_mdio_select_mdc_rate(pdev, priv);
 	ret = ipq4019_mdio_set_div(priv);
@@ -352,7 +366,15 @@
 	/* The platform resource is provided on the chipset IPQ5018 */
 	/* This resource is optional */
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
-	if (res) {
+	if (res && miami) {
+		/* UNIPHY +0x610 also belongs to the PCS register window.
+		 * The bus reset hook enables bit0 before the per-PHY reset.
+		 */
+		priv->eth_ldo_rdy = devm_ioremap(&pdev->dev, res->start,
+						 resource_size(res));
+		if (!priv->eth_ldo_rdy)
+			return -ENOMEM;
+	} else if (res) {
 		priv->eth_ldo_rdy = devm_ioremap_resource(&pdev->dev, res);
 		if (IS_ERR(priv->eth_ldo_rdy))
 			return PTR_ERR(priv->eth_ldo_rdy);
