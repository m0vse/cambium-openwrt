From: Phil Taylor <phil@m0vse.uk>
Subject: [PATCH] remoteproc: qcom: wcss-sec: write the X7-35X user-PD boot record

The Cambium X7-35X (IPQ5332) Q6 firmware expects the user-PD boot record
that the OEM firmware writes to SMEM item 507 before the root PD starts:
a packed version 2 record with the user PD (PID 2) entry point and the
extent of its loaded image. Without it the Q6 reports a fatal error as
soon as it starts and the user PD never spawns.

On this machine only, derive the entry point and extent from the
unchanged user-PD ELF (q6_fw1.mbn), check them against the WCSS memory
region, and write the record before the root PD image is authenticated.
ath12k keeps ownership of the user-PD firmware and its interrupts.

Signed-off-by: Phil Taylor <phil@m0vse.uk>
---
--- a/drivers/remoteproc/qcom_q6v5_wcss_sec.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss_sec.c
@@ -3,6 +3,10 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 #include <linux/clk.h>
+#include <linux/elf.h>
+#include <linux/firmware.h>
+#include <linux/of.h>
+#include <linux/soc/qcom/smem.h>
 #include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/io.h>
 #include <linux/mailbox_client.h>
@@ -36,6 +40,82 @@ struct wcss_data {
 	bool auto_boot;
 };
 
+struct miami_upd_bootinfo {
+	__le16 version;
+	__le16 bytes;
+	u8 type;
+	u8 length;
+	u8 pid;
+	__le32 entry;
+	__le32 file_size;
+} __packed;
+
+static int wcss_miami_bootinfo(struct wcss_sec *wcss)
+{
+	struct miami_upd_bootinfo record = {
+		.version = cpu_to_le16(2), .bytes = cpu_to_le16(11),
+		.type = 2, .length = 9, .pid = 2,
+	};
+	const struct firmware *fw;
+	const struct elf32_hdr *eh;
+	const struct elf32_phdr *ph;
+	u64 max_end = 0, region_end = wcss->mem_phys + wcss->mem_size;
+	u32 min_addr = U32_MAX;
+	size_t size;
+	void *ptr;
+	int i, ret;
+
+	if (!of_machine_is_compatible("cambiumnetworks,x7-35x"))
+		return 0;
+	ret = request_firmware(&fw, "ath12k/IPQ5332/hw1.0/q6_fw1.mbn", wcss->dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (fw->size < sizeof(*eh))
+		goto out;
+	eh = (const struct elf32_hdr *)fw->data;
+	if (memcmp(eh->e_ident, ELFMAG, SELFMAG) ||
+	    eh->e_ident[EI_CLASS] != ELFCLASS32 ||
+	    eh->e_ident[EI_DATA] != ELFDATA2LSB ||
+	    eh->e_phentsize != sizeof(*ph) || eh->e_phoff > fw->size ||
+	    eh->e_phnum > (fw->size - eh->e_phoff) / sizeof(*ph))
+		goto out;
+	ph = (const struct elf32_phdr *)(fw->data + eh->e_phoff);
+	for (i = 0; i < eh->e_phnum; i++) {
+		u64 file_end = (u64)ph[i].p_paddr + ph[i].p_filesz;
+
+		if (ph[i].p_type != PT_LOAD || !ph[i].p_memsz)
+			continue;
+		if (ph[i].p_filesz > ph[i].p_memsz ||
+		    ph[i].p_paddr < wcss->mem_phys ||
+		    (u64)ph[i].p_paddr + ph[i].p_memsz > region_end)
+			goto out;
+		min_addr = min(min_addr, ph[i].p_paddr);
+		max_end = max(max_end, file_end);
+	}
+	if (min_addr == U32_MAX || max_end <= min_addr ||
+	    max_end - min_addr > U32_MAX || eh->e_entry < min_addr ||
+	    eh->e_entry >= max_end)
+		goto out;
+	record.entry = cpu_to_le32(eh->e_entry);
+	record.file_size = cpu_to_le32(max_end - min_addr);
+	ret = qcom_smem_alloc(1, 507, 4096);
+	if (ret && ret != -EEXIST)
+		goto out;
+	ptr = qcom_smem_get(1, 507, &size);
+	if (IS_ERR(ptr)) { ret = PTR_ERR(ptr); goto out; }
+	if (size != 4096) { ret = -EINVAL; goto out; }
+	memset_io(ptr, 0, size);
+	memcpy_toio(ptr, &record, sizeof(record));
+	wmb();
+	dev_info(wcss->dev, "miami-q6 OEM bootinfo v2 pid=2 entry=%#x file_size=%#x\n",
+		 eh->e_entry, le32_to_cpu(record.file_size));
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
+
 static int wcss_sec_start(struct rproc *rproc)
 {
 	struct wcss_sec *wcss = rproc->priv;
@@ -123,6 +203,10 @@ static int wcss_sec_load(struct rproc *rproc, const struct firmware *fw)
 	struct device *dev = wcss->dev;
 	int ret;
 
+	ret = wcss_miami_bootinfo(wcss);
+	if (ret)
+		return ret;
+
 	ret = qcom_mdt_load(dev, fw, rproc->firmware, wcss->desc->pasid, wcss->mem_region,
 			    wcss->mem_phys, wcss->mem_size, &wcss->mem_reloc);
 	if (ret)
