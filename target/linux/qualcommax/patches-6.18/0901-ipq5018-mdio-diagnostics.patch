--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -125,6 +125,7 @@ static int ipq4019_mdio_read_c22(struct mii_bus *bus, int mii_id, int regnum)
 	struct ipq4019_mdio_data *priv = bus->priv;
 	unsigned int data;
 	unsigned int cmd;
+	static unsigned int trace_reads;
 
 	if (ipq4019_mdio_wait_busy(bus))
 		return -ETIMEDOUT;
@@ -148,7 +149,17 @@ static int ipq4019_mdio_read_c22(struct mii_bus *bus, int mii_id, int regnum)
