/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/reset/qcom,gcc-ipq5018.h>

/ {
	model = "Cambium Networks XV2-21X";
	compatible = "cambiumnetworks,xv2-21x", "qcom,ipq5018";

	cambium-platform {
		compatible = "cambium-platform";
		board-sku = <35>;
	};

	aliases {
		label-mac-device = &gmac0;
		serial0 = &blsp1_uart1;
		led-boot = &led_orange;
		led-failsafe = &led_orange;
		led-running = &led_green;
		led-upgrade = &led_orange;
	};

	chosen {
		bootargs-append = " swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* Verified on v8 hardware: green GPIO30, amber GPIO23, blue GPIO24. */
		led_green: led-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_orange: led-orange {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_blue: led-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

/* OEM reserves through 0x4e500000 for the second radio and calibration DB. */
&q6_region {
	reg = <0x0 0x4b000000 0x0 0x3500000>;
};

/* OEM enables the integrated 2.4 GHz radio and the first QCN6122 5 GHz PD. */
&wifi {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Cambium-XV2-21X";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Cambium-XV2-21X-5G";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

/* OEM dp1 is 39c00000.dp1 and uses the IPQ5018 internal PHY at MDIO 7. */
&gmac0 {
	status = "okay";
	label = "lan";
	nvmem-cells = <&macaddr_appsblenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&mdio0 {
	status = "okay";
	/* Test whether this sibling AHB gate is needed by MDIO0. */
	clocks = <&gcc GCC_MDIO0_AHB_CLK>, <&gcc GCC_MDIO1_AHB_CLK>;
	clock-names = "gcc_mdio_ahb_clk", "xv2-mdio1-ahb";
	resets = <&gcc GCC_GEPHY_MDC_SW_ARES>;
	reset-names = "mdio";
};

&ge_phy {
	resets = <&gcc GCC_GEPHY_BCR>, <&gcc GCC_GEPHY_MISC_ARES>;
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <4>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:TRAINING";
				reg = <0x0 0x80000>;
				read-only;
			};

			rootfs: partition@80000 {
				label = "rootfs";
				reg = <0x80000 0x6000000>;
				read-only;
			};

			rootfs_1: partition@6080000 {
				label = "rootfs_1";
				reg = <0x6080000 0x6000000>;
				read-only;
			};

			partition@c080000 {
				label = "0:NVRAM";
				reg = <0xc080000 0x2f80000>;
				read-only;
			};

			partition@f000000 {
				label = "crashLog";
				reg = <0xf000000 0x1000000>;
				read-only;
			};
		};
	};
};

&blsp1_spi1 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "0:MIBIB";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "0:BOOTCONFIG";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				label = "0:BOOTCONFIG1";
				reg = <0x50000 0x10000>;
				read-only;
			};

			partition@60000 {
				label = "0:QSEE";
				reg = <0x60000 0xa0000>;
				read-only;
			};

			partition@100000 {
				label = "0:QSEE_1";
				reg = <0x100000 0xa0000>;
				read-only;
			};

			partition@1a0000 {
				label = "0:DEVCFG";
				reg = <0x1a0000 0x10000>;
				read-only;
			};

			partition@1b0000 {
				label = "mfginfo";
				reg = <0x1b0000 0x10000>;
				read-only;
			};

			partition@1c0000 {
				label = "0:CDT";
				reg = <0x1c0000 0x10000>;
				read-only;
			};

			partition@1d0000 {
				label = "0:CDT_1";
				reg = <0x1d0000 0x10000>;
				read-only;
			};

			partition@1e0000 {
				label = "oldappsblenv";
				reg = <0x1e0000 0x10000>;
				read-only;
			};

			partition@1f0000 {
				label = "0:APPSBL";
				reg = <0x1f0000 0xa0000>;
				read-only;
			};

			partition@290000 {
				label = "0:APPSBL_1";
				reg = <0x290000 0xa0000>;
				read-only;
			};

			partition@330000 {
				label = "0:ART";
				reg = <0x330000 0x70000>;
				read-only;
			};

			partition@3a0000 {
				label = "0:DEVCFG_1";
				reg = <0x3a0000 0x10000>;
				read-only;
			};

			appsblenv: partition@3b0000 {
				label = "0:APPSBLENV";
				reg = <0x3b0000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "u-boot,env";
					env-size = <0x10000>;

					macaddr_appsblenv_ethaddr: ethaddr {
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@3c0000 {
				label = "config";
				reg = <0x3c0000 0x10000>;
				read-only;
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio28";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};
