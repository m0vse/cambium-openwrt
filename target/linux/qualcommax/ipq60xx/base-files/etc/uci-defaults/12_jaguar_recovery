#!/bin/sh

. /lib/functions/system.sh

case "$(board_name)" in
	cambiumnetworks,xv2-2|\
	cambiumnetworks,xv2-2t0|\
	cambiumnetworks,xv2-2t1|\
	cambiumnetworks,xe3-4|\
	cambiumnetworks,xe3-4tn) ;;
	*) exit 0 ;;
esac

# The AP joins the management LAN as a DHCP client. Never offer DHCP or
# router advertisements to the site.
uci -q set dhcp.lan.ignore='1'
uci -q set dhcp.lan.dhcpv4='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q commit dhcp

exit 0
