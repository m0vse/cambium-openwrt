# Shared by every Cambium family snapshot build. Family files select the
# target, devices and per-device package lists.
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# Publish a kmods/target package feed and a self-contained ImageBuilder.
CONFIG_ALL_KMODS=y
CONFIG_ALL_NONSHARED=y
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_COLLECT_KERNEL_DEBUG=n
CONFIG_SIGNED_PACKAGES=y
# Packages added to the persistent images on top of the OpenWrt defaults.
CONFIG_PACKAGE_luci=m
CONFIG_PACKAGE_luci-ssl=m
CONFIG_PACKAGE_openwisp-config=m
CONFIG_PACKAGE_openwisp-monitoring=m
CONFIG_NETJSON_MONITORING_IWINFO=y
CONFIG_PACKAGE_openvpn-mbedtls=m
CONFIG_PACKAGE_wpad-mbedtls=m
CONFIG_PACKAGE_usteer=m
CONFIG_PACKAGE_hostapd-utils=m
CONFIG_PACKAGE_irqbalance=m
CONFIG_PACKAGE_lldpd=m
CONFIG_PACKAGE_ethtool=m
CONFIG_PACKAGE_tcpdump=m
CONFIG_PACKAGE_iperf3=m
CONFIG_PACKAGE_ip-bridge=m
CONFIG_PACKAGE_wireguard-tools=m
CONFIG_PACKAGE_strace=m
CONFIG_PACKAGE_curl=m
CONFIG_PACKAGE_ip-full=m
CONFIG_PACKAGE_iw=m
CONFIG_PACKAGE_ubi-utils=m
CONFIG_PACKAGE_kmod-gpio-button-hotplug=m
CONFIG_PACKAGE_kmod-leds-gpio=m
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=m
